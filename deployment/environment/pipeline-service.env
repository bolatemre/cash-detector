# Pipeline service consumes uploaded videos and runs 2 stages conditionally.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_UPLOADED_VIDEOS_TOPIC=uploaded-videos
KAFKA_STAGE_RESULTS_TOPIC=pipeline-stage-results
KAFKA_CLASSIFICATION_REQUESTS_TOPIC=pipeline-classification-requests
KAFKA_TRACKING_REQUESTS_TOPIC=pipeline-tracking-requests
KAFKA_BANKNOTE_REQUESTS_TOPIC=pipeline-banknote-requests
KAFKA_VLM_REQUESTS_TOPIC=pipeline-vlm-requests
KAFKA_GROUP_ID=pipeline-service-group
KAFKA_SECURITY_EVENTS_TOPIC=security-events
KAFKA_MAX_POLL_INTERVAL_MS=900000
KAFKA_MAX_POLL_RECORDS=1
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_HEARTBEAT_INTERVAL_MS=15000
KAFKA_POLL_TIMEOUT_MS=1000
KAFKA_PROCESSING_MAX_RETRIES=3
KAFKA_PROCESSING_RETRY_BACKOFF_SECONDS=1.0
KAFKA_DLQ_TOPIC=pipeline-dead-letter
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Kafka producer (confluent-kafka)
KAFKA_PRODUCER_CLIENT_ID=pipeline-service
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_RETRY_BACKOFF_MS=100
KAFKA_PRODUCER_FLUSH_TIMEOUT_SECONDS=10.0

# Kafka DLQ producer (confluent-kafka)
KAFKA_DLQ_PRODUCER_CLIENT_ID=pipeline-service-consumer-dlq
KAFKA_DLQ_PRODUCER_FLUSH_TIMEOUT_SECONDS=5.0

# MinIO URL used in published event payload
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=username
MINIO_SECRET_KEY=password
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=security-videos

# Pipeline behavior
SERVICE_NAME=pipeline-service
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
# classification,tracking (default YOLO) or banknote,vlm
STAGE_ORDER=classification,tracking
ALERT_LABELS=suspicious,alert
