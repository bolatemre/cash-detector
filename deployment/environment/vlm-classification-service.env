# VLM classification service — single-stage alternative to classification + tracking.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_TOPIC=pipeline-vlm-requests
KAFKA_GROUP_ID=vlm-classification-service-group
KAFKA_STAGE_RESULTS_TOPIC=pipeline-stage-results
KAFKA_MAX_POLL_INTERVAL_MS=900000
KAFKA_MAX_POLL_RECORDS=1
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_HEARTBEAT_INTERVAL_MS=15000
KAFKA_POLL_TIMEOUT_MS=1000
KAFKA_PROCESSING_MAX_RETRIES=3
KAFKA_PROCESSING_RETRY_BACKOFF_SECONDS=1.0
KAFKA_DLQ_TOPIC=vlm-dead-letter
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_PRODUCER_CLIENT_ID=vlm-classification-service
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_RETRY_BACKOFF_MS=100
KAFKA_PRODUCER_FLUSH_TIMEOUT_SECONDS=10.0
KAFKA_DLQ_PRODUCER_CLIENT_ID=vlm-classification-service-consumer-dlq
KAFKA_DLQ_PRODUCER_FLUSH_TIMEOUT_SECONDS=5.0

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=username
MINIO_SECRET_KEY=password
MINIO_BUCKET=security-videos
MINIO_SECURE=false
TEMP_VIDEO_DIR=/tmp/videos

# Service
SERVICE_NAME=vlm-classification-service
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO

# VLM
MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct-FP8
MODEL_PROCESSOR=Qwen/Qwen3-VL-8B-Instruct-FP8
DTYPE=auto
DEVICE_MAP=auto
MAX_MEMORY={"0":"2GiB","cpu":"14GiB"}
MAX_NEW_TOKENS=1024
DO_SAMPLE=false
TARGET_EXTRACT_FPS=10.0
MAX_ALLOWED_FRAMES=256
MAX_IMAGE_SIZE=576
MAX_RETRIES=2
RETRY_DELAY_SECONDS=10
