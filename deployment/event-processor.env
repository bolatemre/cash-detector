# =============================================================================
# Event Processor Service - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@postgres:5432/database_name

# PostgreSQL schema name for this service's tables
# Allows multiple services to use same database with separate schemas
DATABASE_SCHEMA=event_processor

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
# Kafka broker connection string (host:port)
# Use internal Docker network address for container-to-container communication
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# Kafka topic name from which to consume security event messages
KAFKA_TOPIC=security-events

# Consumer group ID for Kafka message consumption
# Multiple instances with same group ID will share message load
KAFKA_GROUP_ID=event-processor-group

# -----------------------------------------------------------------------------
# Email/SMTP Configuration (required)
# -----------------------------------------------------------------------------
# SMTP server hostname for sending email notifications
# Examples: smtp.gmail.com, smtp.outlook.com, smtp.yourdomain.com
SMTP_HOST=smtp.gmail.com

# SMTP server port number
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted, not recommended)
SMTP_PORT=587

# SMTP server username (usually your email address)
SMTP_USERNAME=email@example.com

# SMTP server password or app-specific password
# For Gmail, use an app-specific password, not your regular password
SMTP_PASSWORD=password

# Email address to use as sender (From field)
# Usually same as SMTP_USERNAME
SMTP_FROM_EMAIL=email@example.com

# Display name for the sender email address
SMTP_FROM_NAME=Security System

# -----------------------------------------------------------------------------
# Notification Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of notification channels to use
# Available channels: email, sms (if SMS service is implemented)
# Example: "email" or "email,sms"
NOTIFICATION_CHANNELS=email

# -----------------------------------------------------------------------------
# Master Service Configuration
# -----------------------------------------------------------------------------
# Base URL of the master service API for service-to-service communication
# Used to fetch additional event context or user information
MASTER_SERVICE_URL=http://master-service:8000

# -----------------------------------------------------------------------------
# Keycloak Configuration (required for service-to-service authentication)
# -----------------------------------------------------------------------------
# Keycloak server base URL for authentication
KEYCLOAK_URL=http://keycloak:8080

# Keycloak realm name where clients are configured
KEYCLOAK_REALM=security-realm

# Client ID registered in Keycloak for this service
KEYCLOAK_CLIENT_ID=event-processor

# Client secret for service-to-service authentication (must match Keycloak configuration)
KEYCLOAK_CLIENT_SECRET=event-processor-secret

# -----------------------------------------------------------------------------
# MinIO Configuration
# -----------------------------------------------------------------------------
# MinIO server endpoint URL (http://host:port) for object storage access
# Use internal Docker network address for container-to-container communication
MINIO_ENDPOINT=http://minio:9000

# Public/external URL for MinIO (used in email notifications with video links)
# Should be accessible from email recipients' browsers
# Use localhost for local development, or public IP/domain for production
MINIO_PUBLIC_URL=http://72.60.20.135:9001

# MinIO access key (username) for authentication
MINIO_ACCESS_KEY=username

# MinIO secret key (password) for authentication
MINIO_SECRET_KEY=password

# MinIO bucket name where suspicious videos are stored
MINIO_BUCKET=suspicious-videos

# Folder/path prefix within bucket for organizing suspicious videos
MINIO_SUSPICIOUS_FOLDER=

# Enable secure HTTPS connection to MinIO (true/false)
# Set to false for local development with HTTP
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Email Templates Configuration
# -----------------------------------------------------------------------------
# Directory path containing email template files (relative to service root)
EMAIL_TEMPLATE_DIR=templates

# HTML email template filename for suspicious event notifications
EMAIL_HTML_TEMPLATE=email_suspicious_event.html

# -----------------------------------------------------------------------------
# Timezone Configuration
# -----------------------------------------------------------------------------
# Server timezone for timestamp formatting in emails and logs
# Examples: UTC, America/New_York, Europe/London
# Use IANA timezone database names
SERVER_TIMEZONE=Europe/Istanbul

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Most verbose, includes detailed debugging information
# INFO: Standard informational messages (recommended for production)
LOG_LEVEL=INFO
