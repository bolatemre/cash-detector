# =============================================================================
# Classification Service - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
# Kafka broker connection string (host:port)
# Use internal Docker network address for container-to-container communication
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# Kafka topic name from which to consume stage requests
KAFKA_TOPIC=pipeline-classification-requests

# Consumer group ID for Kafka message consumption
# Multiple instances with same group ID will share message load
KAFKA_GROUP_ID=classification-service-group

# Kafka topic name where stage execution results are published
KAFKA_STAGE_RESULTS_TOPIC=pipeline-stage-results

# Topic for direct classification events (legacy / event-processor path)
KAFKA_SECURITY_EVENTS_TOPIC=security-events

# -----------------------------------------------------------------------------
# Kafka Consumer Configuration (for handling long-running video processing)
# -----------------------------------------------------------------------------
# Maximum time in milliseconds allowed between poll() calls
# Set high (900000 = 15 minutes) to allow time for video processing
# Consumer will be considered dead if exceeded
KAFKA_MAX_POLL_INTERVAL_MS=900000

# Maximum number of records returned in a single poll() call
# Set to 1 to process one video at a time and avoid timeout issues
KAFKA_MAX_POLL_RECORDS=1

# Timeout in milliseconds to detect consumer failure
# Consumer must send heartbeat within this time or be considered dead
KAFKA_SESSION_TIMEOUT_MS=45000

# Interval in milliseconds between consumer heartbeats to broker
# Must be less than session timeout
KAFKA_HEARTBEAT_INTERVAL_MS=15000
KAFKA_POLL_TIMEOUT_MS=1000
KAFKA_PROCESSING_MAX_RETRIES=3
KAFKA_PROCESSING_RETRY_BACKOFF_SECONDS=1.0
KAFKA_DLQ_TOPIC=classification-dead-letter
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_PRODUCER_CLIENT_ID=classification-service
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_RETRY_BACKOFF_MS=100
KAFKA_PRODUCER_FLUSH_TIMEOUT_SECONDS=10.0
KAFKA_DLQ_PRODUCER_CLIENT_ID=classification-service-consumer-dlq
KAFKA_DLQ_PRODUCER_FLUSH_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# MinIO Configuration
# -----------------------------------------------------------------------------
# MinIO server endpoint URL (http://host:port) for object storage access
# Use internal Docker network address for container-to-container communication
MINIO_ENDPOINT=http://minio:9000

# MinIO access key (username) for authentication
MINIO_ACCESS_KEY=username

# MinIO secret key (password) for authentication
MINIO_SECRET_KEY=password

# MinIO bucket name where video files are stored
MINIO_BUCKET=security-videos

# Enable secure HTTPS connection to MinIO (true/false)
# Set to false for local development with HTTP
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Local Storage Configuration
# -----------------------------------------------------------------------------
# Temporary directory path for downloading videos from MinIO before processing
# Must be writable by the service and have sufficient disk space
TEMP_VIDEO_DIR=/tmp/videos

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
# Service name identifier for logging and monitoring
SERVICE_NAME=classification-service

# Service version identifier for logging and monitoring
SERVICE_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Classification Model Configuration
# -----------------------------------------------------------------------------
# File path to YOLO object detection model (PyTorch .pt format)
# Model detects objects (e.g., banknotes) in video frames
YOLO_MODEL_PATH=/mnt/models/best_20_tiny_state.pt

# File path to action classification model (Keras .keras format)
# Model classifies detected actions as suspicious or normal
ACTION_MODEL_PATH=/mnt/models/model_bi_conv5.keras

# Object class ID to detect (0 = banknote class in YOLO model)
# Must match the class ID in your YOLO model configuration
OBJECT_CLASS_ID=0

# YOLO confidence threshold (0.0-1.0) for object detection
# Higher values (e.g., 0.6) = fewer but more confident detections
# Lower values (e.g., 0.2) = more detections but may include false positives
CONF_THRESHOLD=0.6

# Frame sampling interval in seconds for feature extraction
# Lower values = more frames analyzed but slower processing
# 0.1 seconds = 10 frames per second analyzed
TARGET_INTERVAL=0.1

# When true, process every video frame (ignores TARGET_INTERVAL sampling)
# When false (default), only frames at TARGET_INTERVAL are processed
PROCESS_ALL_FRAMES=false

# Number of frames in sequence for action classification
# Model expects fixed-length sequences for training/inference
SEQUENCE_LENGTH=300

# -----------------------------------------------------------------------------
# MediaPipe Pose Detection Configuration
# -----------------------------------------------------------------------------
# Minimum confidence (0.0-1.0) for pose detection initialization
# Higher values = more confident detections but may miss some poses
POSE_MIN_DETECTION_CONFIDENCE=0.6

# Minimum confidence (0.0-1.0) for pose tracking between frames
# Higher values = more stable tracking but may lose tracking more often
POSE_MIN_TRACKING_CONFIDENCE=0.2

# -----------------------------------------------------------------------------
# Classification Configuration
# -----------------------------------------------------------------------------
# Minimum number of detected features required to run classifier
# Prevents classification on insufficient data
FEATURES_MIN_THRESHOLD=7

# Confidence threshold (0.0-1.0) for suspicious action classification
# If suspicious classification confidence is below this, treat as normal
# Higher values = fewer false positives but may miss some suspicious actions
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# YOLOv7 Custom Model Configuration
# -----------------------------------------------------------------------------
# File path to YOLOv7 model configuration YAML file
# Defines model architecture and training parameters
YOLOV7_CONFIG_PATH=/app/yolov7/cfg/training/yolov7_tiny_2cl.yaml

# Device for YOLOv7 model inference: cpu or cuda
# Use cpu if GPU is not available or to force CPU processing
YOLOV7_DEVICE=cpu

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Most verbose, includes detailed debugging information
# INFO: Standard informational messages (recommended for production)
LOG_LEVEL=INFO
