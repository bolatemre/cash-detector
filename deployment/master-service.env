# =============================================================================
# Master Service - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@postgres:5432/database_name

# PostgreSQL schema name for this service's tables
# Allows multiple services to use same database with separate schemas
DATABASE_SCHEMA=master_service

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Host address to bind the API server (0.0.0.0 = all interfaces)
# Use 0.0.0.0 to accept connections from any network interface
API_HOST=0.0.0.0

# Port number for the API server to listen on
API_PORT=8000

# API title displayed in OpenAPI/Swagger documentation
API_TITLE=Master Service API

# API version identifier for OpenAPI/Swagger documentation
API_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Celery Configuration
# -----------------------------------------------------------------------------
# Redis connection URL for Celery message broker (task queue)
# Used for asynchronous task processing
CELERY_BROKER_URL=redis://redis:6379/0

# Redis connection URL for storing Celery task results
# Used to retrieve results of asynchronous tasks
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Keycloak Configuration (required for JWT validation)
# -----------------------------------------------------------------------------
# Keycloak server base URL for JWT token validation
# Used to validate incoming JWT tokens from authenticated users
KEYCLOAK_SERVER_URL=http://keycloak:8080

# Keycloak realm name where clients and users are configured
KEYCLOAK_REALM=security-realm

# Client ID registered in Keycloak that issues JWT tokens
# Must match the client ID used by the frontend/authentication service
KEYCLOAK_CLIENT_ID=master-service

# JWT signature algorithm used by Keycloak (RS256, HS256, etc.)
# RS256 is recommended for production (asymmetric encryption)
KEYCLOAK_ALGORITHMS=RS256

# -----------------------------------------------------------------------------
# Optional JWKS Configuration (if not using auto-discovery)
# -----------------------------------------------------------------------------
# Direct URL to Keycloak JWKS (JSON Web Key Set) endpoint
# If not set, will be auto-discovered from Keycloak realm configuration
# Format: http://keycloak:8080/realms/{realm}/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/security-realm/protocol/openid-connect/certs

# Time-to-live in seconds for cached JWKS keys
# Reduces requests to Keycloak for key validation
# JWKS_CACHE_TTL_SECONDS=300

# HTTP timeout in seconds for JWKS key fetching requests
# Prevents hanging requests if Keycloak is slow or unavailable
# JWKS_HTTP_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Most verbose, includes detailed debugging information
# INFO: Standard informational messages (recommended for production)
LOG_LEVEL=INFO
