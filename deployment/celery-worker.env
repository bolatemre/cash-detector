# =============================================================================
# Celery Worker Service - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Celery Configuration
# -----------------------------------------------------------------------------
# Redis connection URL for Celery message broker (task queue)
CELERY_BROKER_URL=redis://redis:6379/0

# Redis connection URL for storing Celery task results
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Number of concurrent worker processes/threads for processing tasks
# Higher values increase throughput but consume more resources
CELERY_WORKER_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Task Retry Configuration
# -----------------------------------------------------------------------------
# Maximum number of retry attempts for failed tasks
# Set to empty string or leave unset for unlimited retries
# Set to a number (e.g., 3) to limit retry attempts
CELERY_TASK_MAX_RETRIES=

# Fixed delay in seconds between task retry attempts (in seconds)
CELERY_TASK_RETRY_BACKOFF=30

# Maximum delay in seconds between retry attempts (same as backoff for fixed intervals)
CELERY_TASK_RETRY_BACKOFF_MAX=30

# Enable random jitter for retry intervals (true/false)
# Jitter helps prevent thundering herd problem when multiple tasks fail simultaneously
CELERY_TASK_RETRY_JITTER=false

# -----------------------------------------------------------------------------
# Master Service Configuration
# -----------------------------------------------------------------------------
# Base URL of the master service API for service-to-service communication
MASTER_SERVICE_URL=http://master-service:8000

# -----------------------------------------------------------------------------
# Keycloak Configuration (required for service-to-service authentication)
# -----------------------------------------------------------------------------
# Keycloak server base URL for authentication
KEYCLOAK_URL=http://keycloak:8080

# Keycloak realm name where clients are configured
KEYCLOAK_REALM=security-realm

# Client ID registered in Keycloak for this service
KEYCLOAK_CLIENT_ID=celery-worker

# Client secret for service-to-service authentication (must match Keycloak configuration)
KEYCLOAK_CLIENT_SECRET=celery-worker-secret

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
# Kafka broker connection string (host:port)
# Use internal Docker network address for container-to-container communication
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# Kafka topic name where uploaded video notifications are published
KAFKA_UPLOADED_VIDEOS_TOPIC=uploaded-videos
KAFKA_PRODUCER_CLIENT_ID=celery-worker
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_RETRY_BACKOFF_MS=100
KAFKA_PRODUCER_FLUSH_TIMEOUT_SECONDS=10.0

# -----------------------------------------------------------------------------
# MinIO Configuration
# -----------------------------------------------------------------------------
# MinIO server endpoint (host:port) for object storage access
# Use internal Docker network address for container-to-container communication
MINIO_ENDPOINT=minio:9000

# MinIO access key (username) for authentication
MINIO_ACCESS_KEY=username

# MinIO secret key (password) for authentication
MINIO_SECRET_KEY=password

# MinIO bucket name where video files are stored
MINIO_BUCKET=security-videos

# Enable secure HTTPS connection to MinIO (true/false)
# Set to false for local development with HTTP
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Camera Processing Configuration
# -----------------------------------------------------------------------------
# Maximum number of consecutive failed frame reads before stopping camera processing
# Prevents infinite retry loops on camera connection failures
CAMERA_MAX_FAILED_READS=60

# Interval in seconds for logging FPS (frames per second) statistics
CAMERA_FPS_LOG_INTERVAL=1.0

# FPS threshold below which a warning is logged (indicates performance issues)
CAMERA_FPS_WARNING_THRESHOLD=10.0

# Timeout in seconds to wait after hands disappear before stopping video recording
# Prevents premature recording stops during brief hand occlusions
CAMERA_NO_HAND_TIMEOUT=10.0

# -----------------------------------------------------------------------------
# MediaPipe Hands (trigger) configuration
# -----------------------------------------------------------------------------
# MediaPipe Hands detector is used as a trigger to start/stop recording.
# Tune these to balance sensitivity vs false triggers.
MEDIAPIPE_HANDS_MAX_NUM_HANDS=2
MEDIAPIPE_HANDS_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_HANDS_MIN_TRACKING_CONFIDENCE=0.3

# -----------------------------------------------------------------------------
# Video Recording Configuration
# -----------------------------------------------------------------------------
# Video codec for encoding recorded videos (libx264, libx265, etc.)
# libx264 provides good compatibility and quality
VIDEO_CODEC=libx264

# Encoding preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
# Faster presets use more CPU but produce larger files
# Slower presets use less CPU but produce smaller files with better compression
VIDEO_PRESET=medium

# Constant Rate Factor (CRF) for video quality: 0-51, lower=better quality
# 23 is default, 28 is good for surveillance (smaller file size)
# Range: 0 (lossless) to 51 (worst quality)
VIDEO_CRF=23

# Pixel format for video encoding (yuv420p provides best compatibility)
VIDEO_PIXEL_FORMAT=yuv420p

# Maximum recording duration in seconds before automatically stopping
# Prevents unlimited recording in case of errors
VIDEO_MAX_DURATION=90.0

# -----------------------------------------------------------------------------
# FFmpeg Decoder Configuration (for handling HEVC errors)
# -----------------------------------------------------------------------------
# Error detection mode: crccheck, bitstream, buffer, explode, ignore_err, careful, compliant, aggressive
# ignore_err: Ignore errors and continue decoding (useful for corrupted streams)
# careful: More careful error detection
# aggressive: Aggressive error detection and recovery
FFMPEG_ERR_DETECT=ignore_err

# Decoder flags: +genpts (generate presentation timestamps), +discardcorrupt (discard corrupted frames), +low_delay (low latency)
# Multiple flags can be combined with + separator
FFMPEG_FLAGS=+genpts+discardcorrupt+low_delay

# Error recognition level: careful, compliant, aggressive, very_aggressive
# Determines how strictly FFmpeg validates stream data
FFMPEG_ERROR_RECOGNITION=careful

# -----------------------------------------------------------------------------
# MediaPipe and GPU Configuration
# -----------------------------------------------------------------------------
# Disable GPU acceleration for MediaPipe (1=disabled, 0=enabled)
# Set to 1 if GPU is not available or to force CPU processing
MEDIAPIPE_DISABLE_GPU=1

# Force MediaPipe to use CPU only (1=CPU only, 0=allow GPU)
# Set to 1 for consistent behavior across different hardware
MEDIAPIPE_USE_CPU_ONLY=1

# CUDA visible devices: -1=disable CUDA, 0=use GPU 0, 0,1=use GPUs 0 and 1
# Set to -1 to disable CUDA completely
CUDA_VISIBLE_DEVICES=-1

# OpenCV OpenCL runtime: disabled, default, or specific runtime name
# Set to disabled to prevent OpenCL usage
OPENCV_OPENCL_RUNTIME=disabled

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Most verbose, includes detailed debugging information
# INFO: Standard informational messages (recommended for production)
LOG_LEVEL=INFO
